# --- Cloud LLM provider keys (any subset may be set) ---
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Default model per provider, confirmed against each provider's genuinely
# free tier as of 2026-08 (see DECISIONS.md D-022). Catalogs drift -- these
# are overridable and not meant to be permanent.
# NVIDIA_MODEL_NAME=nvidia/llama-3.3-nemotron-super-49b-v1
# GROQ_MODEL_NAME=llama-3.1-8b-instant
# OPENROUTER_MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free

# --- Optional Google Gemini key ---
GEMINI_API_KEY=
# GEMINI_MODEL_NAME=gemini-2.5-flash

# --- Local-model settings (used when running an OpenAI-compatible local server) ---
# Example: Ollama, vLLM, LM Studio, llama.cpp server, etc.
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL_NAME=
LOCAL_MODEL_API_KEY=

# --- Embedding settings (local, on-device via sentence-transformers) ---
# Default matches CLAUDE.md's Day 4 guidance. Documented alternatives
# (not wired yet): jina-embeddings-v2-base-code, bge-small-en-v1.5.
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# EMBEDDING_BATCH_SIZE=32

# --- Retrieval settings (hybrid BM25 + vector merge via Reciprocal Rank Fusion) ---
# RRF_K=60
# HYBRID_CANDIDATE_POOL_SIZE=50

# --- Reranker settings (local cross-encoder reorders the hybrid candidate pool) ---
# Default matches CLAUDE.md's Day 6 guidance. Documented alternatives
# (not wired yet): bge-reranker-base (larger, stronger multilingual
# relevance, higher latency), mxbai-rerank-base-v1 (newer, competitive
# quality, less battle-tested at this project's scale).
# RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANKER_MAX_LENGTH=512
# RERANK_TOP_N=8

# --- LLM generation settings (fallback chain: NVIDIA -> Groq -> OpenRouter -> Gemini -> Local) ---
# At least one provider key above (or LOCAL_MODEL_NAME) must be set for
# generate_answer to produce a real answer -- see DECISIONS.md D-022 for the
# confirmed free-tier model per provider and manual smoke test results.
# GENERATION_TEMPERATURE=0.1
# GENERATION_MAX_TOKENS=1024
# GENERATION_JSON_RETRY_LIMIT=1
# GENERATION_REQUEST_TIMEOUT_SECONDS=30

# --- Runtime configuration ---
# LOG_LEVEL=INFO
# DATA_DIR=./data
# INDEX_DIR=./data/index

# --- Auto-indexing settings (Day 12: zero-config `serve` startup) ---
# When `codebase-rag serve` finds no usable index under INDEX_DIR (or an
# existing index's manifest doesn't match the repo now being served), it
# builds one automatically in the background rather than failing -- the
# MCP connection itself is never blocked on that build. REPO_SOURCE (an
# https:// git URL or a local path) sets the default source to auto-index;
# if unset, `serve` falls back to the current directory, but only if it
# contains a .git directory (never an implicit remote clone). A large repo
# may take a while to finish building; tool calls made before it's done
# return a clear "still building" error instead of hanging or answering
# with misleading results. Set AUTO_INDEX=false to disable this entirely
# and require an index already built by `codebase-rag index` first -- the
# same `--repo`/`--index-dir`/`--no-auto-index` flags are also available
# directly on `codebase-rag serve`.
# REPO_SOURCE=
# AUTO_INDEX=true
